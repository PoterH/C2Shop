# CONFIGURAÇÕES DO EFÍ BANK (API DE PAGAMENTOS)
# Caso as chaves abaixo não estejam configuradas, a aplicação rodará AUTOMATICAMENTE em Modo Mock (Simulação)
# para facilitar o desenvolvimento local e demonstrações sem exigir chaves reais.

# Identificador da sua conta Efí (Payee Code) para tokenização do cartão de crédito no frontend
VITE_EFI_ACCOUNT_IDENTIFIER=seu_identificador_de_conta_aqui
VITE_EFI_ENVIRONMENT=sandbox # ou production

# Define se está rodando em Sandbox (ambiente de testes) ou Produção (producao/false)
EFI_SANDBOX=true

# Chave Pix associada à conta Efí que receberá os pagamentos Pix
EFI_PIX_KEY=sua_chave_pix_aqui

# Credenciais de Sandbox (Efí > API > Minhas Aplicações > Escolha a aplicação > Sandbox)
EFI_SANDBOX_CLIENT_ID=seu_sandbox_client_id_aqui
EFI_SANDBOX_CLIENT_SECRET=seu_sandbox_client_secret_aqui

# Credenciais de Produção (Efí > API > Minhas Aplicações > Escolha a aplicação > Produção)
EFI_CLIENT_ID=seu_client_id_aqui
EFI_CLIENT_SECRET=seu_client_secret_aqui

# Certificado .p12 convertido em string Base64 (obrigatório para requisições mTLS do Pix)
# Para gerar no Windows/macOS/Linux:
# No terminal execute: openssl base64 -in seu_certificado.p12 -out certificado_base64.txt
# Abra o arquivo gerado, copie todo o texto e cole abaixo (removendo quebras de linha se existirem):
EFI_CERTIFICATE_BASE64=sua_string_base64_aqui

# InfinitePay: configurar apenas no servidor, nunca com prefixo VITE_.
# Mantenha desativado até configurar credenciais e validar entrega.
INFINITEPAY_ENABLED=false
INFINITEPAY_API_KEY=
# Banco Redis REST compatível com Upstash (URL HTTPS e token de leitura/escrita).
INFINITEPAY_REDIS_URL=
INFINITEPAY_REDIS_TOKEN=
